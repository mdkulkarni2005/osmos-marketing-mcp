                "budget_setting": {
                  "daily_budget": 2,
                  "currency": "INR",
                  "max_limit": -1,
                  "budget_pacing": "ACCELERATED",
                  "budget_type": "AVERAGE_DAILY_BUDGET",
                  "daily_budget_multiplier": 1
                },
                "bidding_strategy": {
                  "type": "MANUAL_CPC",
                  "value": 1
                }
              },
              {
                "campaign_id": "861231",
