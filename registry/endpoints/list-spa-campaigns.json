{
  "endpoint": {
    "id": "list-spa-campaigns",
    "serviceId": "osmos-marketing-api",
    "name": "List SPA Campaigns",
    "method": "GET",
    "path": "/{advertiser_id}/sponsored_products/legacy/campaigns",
    "operationId": "list-spa-campaigns-legacy",
    "summary": "List all SPA campaigns for an advertiser with pagination and optional status filter",
    "description": "Returns a paginated list of campaigns. Supports filtering by status (ACTIVE, PAUSED). Offset and limit are required for pagination.",
    "deprecated": false,
    "parameters": [
      {
        "name": "advertiser_id",
        "in": "path",
        "required": true,
        "type": "integer",
        "format": "int32",
        "description": "Osmos generated unique identifier for the onboarded advertiser."
      },
      {
        "name": "offset",
        "in": "query",
        "required": true,
        "type": "integer",
        "format": "int32",
        "minimum": 0,
        "description": "Pagination offset."
      },
      {
        "name": "limit",
        "in": "query",
        "required": true,
        "type": "integer",
        "format": "int32",
        "minimum": 1,
        "maximum": 50,
        "description": "Maximum number of campaigns to return. Must be greater than 0 and less than or equal to 50."
      },
      {
        "name": "status",
        "in": "query",
        "required": false,
        "type": "string",
        "enum": ["ACTIVE", "PAUSED"],
        "description": "Filter campaigns by status."
      }
    ],
    "requestBody": {
      "required": false
    },
    "responses": {
      "200": {
        "description": "Campaigns retrieved successfully",
        "contentType": "application/json",
        "example": {
          "result": {
            "campaigns": [
              {
                "campaign_id": "861230",
                "name": "All Products (2nd Mar | 21:59)",
                "status": "DRAFT",
                "campaign_type": "SMART_SHOPPING",
                "campaign_start_date": "2025-03-02T21:59:46+05:30",
